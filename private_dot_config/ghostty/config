# Ghostty / cmux共通設定
# フォントはcmuxがここから読み取るため、macOS(cmux)・Linux(Ghostty)で共有

# Theme and colors
theme = "Dracula"
background = #000000

# Transparency
background-opacity = 1
background-blur-radius = 20

# Font - WezTermと統一 (HackGen Console NF / size 14)
font-family = "HackGen Console NF"
font-size = 14

# Cursor
cursor-style = block
cursor-style-blink = true

# Keybindings (Linux)
keybind = alt+left=unbind
keybind = alt+right=unbind

# 分割操作
keybind = ctrl+shift+q=close_surface
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up
keybind = ctrl+l=goto_split:right
keybind = ctrl+z=toggle_split_zoom

# タブ操作
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

