#!/usr/bin/env sh
# 外部ディスプレイを「Chrome | Obsidian(+Slack stack)」に整える
wid() { yabai -m query --windows | jq --arg a "$1" '[.[] | select(.app == $a and .["is-minimized"] == false)][0].id'; }
fx()  { yabai -m query --windows --window "$1" | jq '.frame.x'; }
CH=$(wid "Google Chrome"); OB=$(wid "Obsidian"); SL=$(wid "Slack")
{ [ "$CH" = null ] || [ "$OB" = null ]; } && exit 0

DISP=$(yabai -m query --windows --window "$CH" | jq '.display')
SP=$(yabai -m query --windows --window "$CH" | jq '.space')

for w in "$OB" "$SL"; do
  [ "$w" = null ] && continue
  # float を2回トグルして stack/bsp の所属をリセットし、Chrome と同じディスプレイへ
  yabai -m window "$w" --toggle float >/dev/null 2>&1
  yabai -m window "$w" --toggle float >/dev/null 2>&1
  yabai -m window "$w" --display "$DISP" >/dev/null 2>&1
done
yabai -m space "$SP" --layout bsp
[ "$SL" = null ] || yabai -m window "$SL" --stack "$OB"
yabai -m space "$SP" --balance
# Chrome を左に
if [ "$(jq -n --argjson a "$(fx "$CH")" --argjson b "$(fx "$OB")" '$a > $b')" = true ]; then
  yabai -m window "$CH" --swap "$OB"
fi
yabai -m window --focus "$CH"
